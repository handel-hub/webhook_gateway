{
  "name": "webhook_gateway",
  "version": "1.0.0",
  "description": "Centralized Webhook Ingestion and Delivery Service (CWIDS)",
  "type": "module",
  "main": "src/index.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "start:gateway": "node src/server.mjs",
    "start:worker": "node src/worker.mjs",
    "migrate": "node src/db/migrate.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test",
    "circular-check": "madge --circular src/"
  },
  "keywords": [
    "webhook",
    "gateway",
    "ingestion",
    "delivery",
    "cwids",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "madge": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
